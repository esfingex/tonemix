/* ToneMix Pro - Dark Theme Stylesheet */

/* Main Window */
QMainWindow {
    background-color: #1a1a1a;
    color: #e0e0e0;
}

/* Menu Bar */
QMenuBar {
    background-color: #2a2a2a;
    color: #e0e0e0;
    border-bottom: 1px solid #3a3a3a;
    padding: 4px;
}

QMenuBar::item {
    padding: 6px 12px;
    background-color: transparent;
}

QMenuBar::item:selected {
    background-color: #3a3a3a;
    border-radius: 4px;
}

QMenuBar::item:pressed {
    background-color: #00d9ff;
    color: #1a1a1a;
}

/* Toolbar */
QToolBar {
    background-color: #2a2a2a;
    border: none;
    spacing: 8px;
    padding: 4px;
}

QToolButton {
    background-color: #3a3a3a;
    color: #e0e0e0;
    border: none;
    border-radius: 4px;
    padding: 8px 12px;
    font-size: 13px;
}

QToolButton:hover {
    background-color: #4a4a4a;
}

QToolButton:pressed {
    background-color: #2a2a2a;
}

/* Buttons */
QPushButton {
    background-color: #3a3a3a;
    color: #e0e0e0;
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-size: 13px;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #4a4a4a;
}

QPushButton:pressed {
    background-color: #2a2a2a;
}

QPushButton:disabled {
    background-color: #2a2a2a;
    color: #666666;
}

QPushButton.accent {
    background-color: #00d9ff;
    color: #1a1a1a;
    font-weight: bold;
}

QPushButton.accent:hover {
    background-color: #00c0e6;
}

/* Table View */
QTableView {
    background-color: #1e1e1e;
    alternate-background-color: #222222;
    color: #e0e0e0;
    gridline-color: #2a2a2a;
    selection-background-color: #3a3a3a;
    selection-color: #ffffff;
    border: 1px solid #2a2a2a;
}

QTableView::item {
    padding: 4px;
}

QTableView::item:hover {
    background-color: #2a2a2a;
}

QTableView::item:selected {
    background-color: #3a3a3a;
}

QHeaderView::section {
    background-color: #252525;
    color: #b0b0b0;
    padding: 8px;
    border: none;
    border-right: 1px solid #2a2a2a;
    border-bottom: 1px solid #2a2a2a;
    font-weight: bold;
}

QHeaderView::section:hover {
    background-color: #2a2a2a;
}

/* Tree View (Playlists) */
QTreeView {
    background-color: #1a1a1a;
    color: #e0e0e0;
    border: none;
    border-right: 1px solid #2a2a2a;
    outline: none;
}

QTreeView::item {
    padding: 6px;
    border-radius: 4px;
}

QTreeView::item:hover {
    background-color: #2a2a2a;
}

QTreeView::item:selected {
    background-color: #3a3a3a;
    color: #ffffff;
}

QTreeView::branch {
    background-color: transparent;
}

/* Scroll Bars */
QScrollBar:vertical {
    background-color: #1a1a1a;
    width: 12px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #3a3a3a;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4a4a4a;
}

QScrollBar:horizontal {
    background-color: #1a1a1a;
    height: 12px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #3a3a3a;
    border-radius: 6px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4a4a4a;
}

QScrollBar::add-line, QScrollBar::sub-line {
    border: none;
    background: none;
}

/* Splitter */
QSplitter::handle {
    background-color: #2a2a2a;
}

QSplitter::handle:hover {
    background-color: #3a3a3a;
}

/* Line Edit */
QLineEdit {
    background-color: #2a2a2a;
    color: #e0e0e0;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    padding: 6px;
    selection-background-color: #00d9ff;
    selection-color: #1a1a1a;
}

QLineEdit:focus {
    border: 1px solid #00d9ff;
}

/* Combo Box */
QComboBox {
    background-color: #2a2a2a;
    color: #e0e0e0;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    padding: 6px;
}

QComboBox:hover {
    border: 1px solid #4a4a4a;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #2a2a2a;
    color: #e0e0e0;
    selection-background-color: #3a3a3a;
    border: 1px solid #3a3a3a;
}

/* Progress Bar */
QProgressBar {
    background-color: #2a2a2a;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    text-align: center;
    color: #e0e0e0;
}

QProgressBar::chunk {
    background-color: #00d9ff;
    border-radius: 3px;
}

/* Status Bar */
QStatusBar {
    background-color: #2a2a2a;
    color: #b0b0b0;
    border-top: 1px solid #3a3a3a;
}

/* Label */
QLabel {
    color: #e0e0e0;
}

/* Group Box */
QGroupBox {
    color: #e0e0e0;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 4px;
    color: #00d9ff;
}

/* Waveform Widget */
WaveformWidget {
    background-color: #2a2a2a;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
}

/* Drop Zone */
DropZone {
    background-color: #252525;
    border: 2px dashed #3a3a3a;
    border-radius: 8px;
}

DropZone:hover {
    border-color: #00d9ff;
    background-color: #2a2a2a;
}
